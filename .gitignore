.env
data/
secrets/*
!secrets/.gitkeep
__pycache__/
*.pyc
.venv/
captures/
backups/
*.fbk
frontend/node_modules/
frontend/dist/

# Réglages locaux (par machine)
**/.claude/settings.local.json
.DS_Store
Thumbs.db

# Exécutables du lanceur Windows : générés depuis les .ps1 (voir README §1).
*.exe

# Outils Windows : config machine + journaux locaux (exe couverts par *.exe).
capture-bureau/*.config.txt
capture-bureau/*.log

# Raccourcis Windows et archives de sauvegarde locales (pas du code source).
*.lnk
FaithBook-source*.zip
# Export packagé (copie complète + exécutables), régénérable, pas du code source.
deliverable/
# Cache de build TypeScript.
frontend/tsconfig.tsbuildinfo

# Sauvegardes de configuration : contiennent des secrets
.env.bak*
comparaison_run*.png

# Archives et copies de travail, jamais versionnees
/FaithBook-frontend-editorial/
/FaithBook-frontend-editorial.zip
/backup/
/faithbook/

# sauvegardes automatiques des scripts de maintenance
*.bak
*.bak-*

# sorties du validateur de cibles
cibles-validees.csv
cibles-rejetees.csv
