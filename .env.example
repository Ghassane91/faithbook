# ---------------------------------------------------------------
# Copier ce fichier en .env puis adapter. AUCUNE valeur en dur
# dans le code : le passage local -> VPS se fait uniquement ici.
#
# IMPORTANT : ne jamais mettre de commentaire en fin de ligne.
# Docker Compose ne les retire pas et ils deviennent une partie
# de la valeur. Un commentaire = une ligne entiere.
# ---------------------------------------------------------------

# --- API ---
API_PORT=8000
# Cle machine-a-machine pour les scripts et l'integration (en-tete X-API-Key).
# N'a rien a voir avec les comptes utilisateurs : vide = pas d'acces par cle.
API_KEY=
# Compte reel au nom duquel la cle API agit. Il conserve l'acces autorise aux
# comptes Facebook/noVNC, avec les memes controles de propriete que l'interface.
# Vide = ADMIN_EMAIL, mais une valeur explicite est recommandee.
API_KEY_USER_EMAIL=admin@local
# development | test | production. En production, /docs est desactive et
# SESSION_ENCRYPTION_KEY devient obligatoire.
ENVIRONMENT=development
CORS_ORIGINS=*
# Relais autorises a transmettre l'IP reelle. Ne pas ajouter de reseau client.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# --- Authentification (interface web) ---
# Compte initial cree au premier demarrage.
# Si ADMIN_PASSWORD est vide, un mot de passe aleatoire est genere et affiche
# UNE SEULE FOIS dans les journaux du conteneur, avec changement impose.
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=
# Duree d'une session (heures) avant reconnexion.
SESSION_HOURS=12
# Passer a true derriere HTTPS : le cookie de session ne partira plus en clair.
COOKIE_SECURE=false

# --- Comptes connectes (sessions Facebook chiffrees, connexion noVNC) ---
# Cle de chiffrement (Fernet) des sessions et profils navigateur au repos.
# VIDE en local : une cle est generee dans data/.session_key au 1er demarrage
# (avertissement dans les journaux). EN PRODUCTION : generer une cle
# (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# et la fixer ici — sans elle au meme endroit a chaque demarrage, les sessions
# chiffrees deviennent illisibles si le fichier data/.session_key est perdu.
SESSION_ENCRYPTION_KEY=
# Mot de passe du serveur VNC interne (ecran de connexion manuelle). Vide =
# ecoute uniquement en local dans le conteneur (le proxy nginx est de toute
# facon le seul chemin d'acces, protege par session + jeton, voir plus bas).
VNC_PASSWORD=
# Duree maximale d'une connexion manuelle avant fermeture automatique (minutes).
LOGIN_TIMEOUT_MINUTES=15
# Duree de vie du jeton qui autorise l'acces a l'ecran noVNC (minutes). Courte
# et independante de LOGIN_TIMEOUT_MINUTES : limite la fenetre d'exposition
# meme si la connexion manuelle elle-meme dure plus longtemps.
NOVNC_TOKEN_TTL_MINUTES=10

# --- Navigation securisee ---
# Configure automatiquement par docker-compose vers le proxy Squid interne.
# Pour autoriser volontairement des cibles privees en environnement de
# confiance, mettre ALLOW_PRIVATE_TARGETS=true ET BROWSER_PROXY_URL vide.
BROWSER_PROXY_URL=http://egress-proxy:3128
ALLOWED_DOMAINS=
ALLOW_PRIVATE_TARGETS=false

# --- Mot de passe oublie (reinitialisation par mail) ---
# URL publique de l'interface : base du lien envoye par mail.
#   Local : http://localhost:3000    VPS : https://votre-domaine
PUBLIC_URL=http://localhost:3000
# Duree de validite du lien de reinitialisation (minutes).
RESET_TOKEN_MINUTES=60
# Duree de validite des invitations d'organisation (jours).
INVITATION_DAYS=7
# SMTP. Si SMTP_HOST est vide, AUCUN mail n'est envoye : le lien de
# reinitialisation ou d'invitation est ecrit dans les journaux du conteneur.
#   docker compose logs backend | grep -A8 "E-MAIL NON ENVOYE"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Adresse expeditrice ; a defaut, SMTP_USER est utilise.
SMTP_FROM=

# --- Notifications & rapport (envoyes via le bloc SMTP ci-dessus) ---
# Destinataire des alertes (vide = l'adresse du premier utilisateur).
NOTIFY_EMAIL=
# Mail immediat quand une capture echoue apres tous les reessais.
NOTIFY_ON_FAILURE=true
# Rapport quotidien recapitulatif : captures d'hier + etat des sessions.
DAILY_REPORT_TIME=08:00
# Controle quotidien des sessions des comptes connectes, avec alerte si une
# session est expiree ou demande une verification.
SESSION_CHECK_TIME=07:30
# Alerte preventive si un cookie a une expiration connue dans moins de N jours.
SESSION_EXPIRY_WARNING_DAYS=7

# --- Detection de changement (veille) ---
# Une capture est marquee "modifiee" si la part de la page qui change depasse ce
# seuil (0.03 = 3%). Badge dans la Planche et l'Historique.
CHANGE_THRESHOLD=0.03
# Mail "la page X a change" a chaque changement detecte (peut etre bavard).
NOTIFY_ON_CHANGE=false

# --- Planification ---
# Fuseau utilise pour les horaires ET pour le nom des dossiers dates.
TIMEZONE=Africa/Casablanca

# --- Stockage ---
# local : conserve uniquement les captures dans OUTPUT_DIR.
# google_drive : conserve aussi la copie locale, puis l'envoie vers Drive.
STORAGE_BACKEND=local

# DOSSIER DE SORTIE DES CAPTURES (cote machine hote).
# C'est la seule ligne a changer pour deplacer les captures.
#   Windows : utiliser des barres obliques normales, ex. C:/Users/G/Desktop/Captures
#   VPS     : /var/captures
# Les sous-dossiers dates "AAAA-MM-JJ" sont crees automatiquement dedans.
OUTPUT_DIR=./captures

# Chemins INTERNES au conteneur : ne pas modifier.
DATA_DIR=/data
SCREENSHOT_DIR=/output

# PostgreSQL local. Choisir un mot de passe différent avant un déploiement VPS.
POSTGRES_DB=faithbook
POSTGRES_USER=faithbook
POSTGRES_PASSWORD=faithbook-local-change-me
POSTGRES_DATABASE_URL=postgresql+psycopg://faithbook:faithbook-local-change-me@db:5432/faithbook
# Compose construit DATABASE_URL avec ces valeurs. L'ancienne base SQLite
# data/app.db est copiée automatiquement au premier démarrage puis conservée.
AUTO_MIGRATE_SQLITE=true
LEGACY_SQLITE_PATH=/data/app.db

# File de captures. Compose force Redis ; inline reste utile pour les tests.
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=faithbook:capture-runs

# Format du nom des dossiers dates.
FOLDER_DATE_FORMAT=%Y-%m-%d

# --- Google Drive API (facultatif) ---
# 1. Placer la cle JSON hors Git dans ./secrets/service-account.json.
# 2. Donner au compte de service l'accès en écriture au dossier parent.
# 3. Renseigner les identifiants ci-dessous et STORAGE_BACKEND=google_drive.
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/service-account.json
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Recommandé avec un compte de service : identifiant du Drive partagé.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Nouvelles tentatives internes Google sur 429/5xx et reprises FaithBook.
GOOGLE_DRIVE_API_RETRIES=3
GOOGLE_DRIVE_RETRY_MINUTES=5
GOOGLE_DRIVE_RETRY_BATCH_SIZE=20

# --- Capture ---
DEFAULT_VIEWPORT_WIDTH=1440
DEFAULT_VIEWPORT_HEIGHT=900
DEFAULT_TIMEOUT_MS=45000
DEFAULT_WAIT_AFTER_LOAD_MS=2000
DEFAULT_USER_AGENT=
# Règle générale des captures pleine page : faire défiler progressivement pour
# charger les publications/images différées, puis remonter et créer le PNG.
AUTO_SCROLL_FULL_PAGE=true
AUTO_SCROLL_DELAY_MS=900
AUTO_SCROLL_MAX_STEPS=50
AUTO_SCROLL_STABLE_ROUNDS=4

# --- Fiabilite ---
# Nombre total de tentatives par execution.
MAX_ATTEMPTS=3
# Attente entre tentatives : 15s, 30s, 60s ...
RETRY_BACKOFF_SECONDS=15
# per_day | content_hash | both | off
DEDUPE_MODE=per_day
# Valeurs initiales de chaque nouvelle organisation. 0 = illimite.
DEFAULT_QUOTA_ACCOUNTS=10
DEFAULT_QUOTA_TARGETS=100
DEFAULT_QUOTA_DAILY_CAPTURES=500
# 10 Gio. Sont comptes les PNG locaux enregistres par les executions.
DEFAULT_QUOTA_STORAGE_BYTES=10737418240
# Retention initiale des nouvelles organisations (jours, 0 = jamais).
# Chaque organisation conserve ensuite sa propre valeur en base.
RUN_RETENTION_DAYS=90

# --- Logs ---
LOG_LEVEL=INFO
LOG_FILE=/data/app.log

# --- Frontend ---
# Port de l'interface web.
FRONTEND_PORT=3000

# ---------------------------------------------------------------------
# Stockage S3 (STORAGE_BACKEND=s3) : AWS, Backblaze B2, Wasabi, MinIO
# Laisser commente tant que STORAGE_BACKEND n est pas "s3" : une valeur
# vide sur les reglages numeriques empeche le demarrage.
# ---------------------------------------------------------------------
#S3_BUCKET=mon-bucket
#S3_REGION=eu-central-003
#S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_PREFIX=faithbook/
#S3_SIGNED_URL_TTL_SECONDS=3600

# ---------------------------------------------------------------------
# Synthese IA des changements (optionnelle, desactivee par defaut)
# Sans cle, FaithBook fonctionne exactement comme avant.
# Cle a creer sur console.anthropic.com, a garder secrete.
# ---------------------------------------------------------------------
AI_SUMMARY_ENABLED=false
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-opus-5
AI_SUMMARY_RETRIES=2

# ---------------------------------------------------------------------
# Canaux d alerte complementaires (en plus du mail, tous optionnels)
# Vides = inactifs. Une panne d un canal n empeche pas les autres.
# Telegram : creer un bot avec @BotFather, recuperer le jeton, puis le
#   chat_id en ecrivant au bot et en ouvrant
#   https://api.telegram.org/bot<JETON>/getUpdates
# Webhook : une seule URL couvre Slack, Discord et n8n
# ---------------------------------------------------------------------
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
NOTIFY_CHANNEL_TIMEOUT_SECONDS=10
